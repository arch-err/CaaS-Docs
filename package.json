{
  "name": "caas-docs-poc",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:pages": "CAAS_DOCS_TARGET=github-pages astro build --outDir github-pages-dist",
    "preview": "astro preview",
    "test": "bun test",
    "typecheck": "astro check",
    "validate:docs": "bun scripts/validate-docs.ts",
    "lint:markdown": "markdownlint-cli2",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run validate:docs && bun run test && bun run lint:markdown && bun run typecheck && bun run build"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.41.7",
    "astro": "^7.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/bun": "^1.3.14",
    "js-yaml": "^5.3.0",
    "markdownlint-cli2": "^0.23.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3"
  }
}
