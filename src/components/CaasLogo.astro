---
import defaultLogo from '../assets/default-logo.svg?url';
import containerBadge from '../assets/container-badge.svg?url';
import chartBadge from '../assets/chart-badge.svg?url';
import { resolveLogo } from '../lib/logo';

interface Props {
  slug: string;
  title: string;
  type: 'container' | 'chart';
  variant?: 'card' | 'detail';
}

const { slug, title, type, variant = 'card' } = Astro.props;
const logoModules = import.meta.glob<string>(
  '../content/docs/services/*/logo.{svg,png,jpg}',
  { eager: true, query: '?url', import: 'default' },
);
const logo = resolveLogo(logoModules, slug);
const initials = title
  .split(/\s+/)
  .slice(0, 2)
  .map((word) => word[0])
  .join('')
  .toLocaleUpperCase();
const badge = type === 'chart' ? chartBadge : containerBadge;
---

<span
  class:list={['caas-logo', `caas-logo--${variant}`]}
  data-logo-source={logo ? 'custom' : 'default'}
  aria-label={`${title} (${type})`}
>
  <img class="caas-logo__image" src={logo ?? defaultLogo} alt="" />
  {
    !logo && (
      <span class="caas-logo__initials" aria-hidden="true">
        {initials}
      </span>
    )
  }
  <img class="caas-logo__badge" src={badge} alt="" aria-hidden="true" />
</span>

<style>
  .caas-logo {
    position: relative;
    display: inline-grid;
    width: 4.25rem;
    height: 4.25rem;
    flex: 0 0 auto;
    place-items: center;
  }

  .caas-logo--detail {
    width: clamp(5.5rem, 12vw, 7rem);
    height: clamp(5.5rem, 12vw, 7rem);
  }

  .caas-logo__image {
    width: 100%;
    height: 100%;
    border: 1px solid var(--catalog-border);
    border-radius: 22%;
    background: var(--sl-color-black);
    object-fit: contain;
  }

  .caas-logo__initials {
    position: absolute;
    color: #f8fafc;
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: -0.04em;
  }

  .caas-logo--detail .caas-logo__initials {
    font-size: 1.65rem;
  }

  .caas-logo__badge {
    position: absolute;
    right: -5%;
    bottom: -5%;
    width: 38%;
    height: 38%;
    border: 2px solid var(--sl-color-bg);
    border-radius: 50%;
    filter: drop-shadow(0 0.15rem 0.3rem rgb(0 0 0 / 35%));
  }
</style>
