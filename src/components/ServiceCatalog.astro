---
import { getCollection } from 'astro:content';

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const entries = (await getCollection('docs'))
  .filter((entry) => entry.data.caas)
  .map((entry) => {
    const caas = entry.data.caas!;
    const route = entry.id.replace(/\/index$/, '');

    return {
      title: entry.data.title,
      description: entry.data.description,
      href: `${basePath}/${route}/`,
      ...caas,
    };
  })
  .sort((left, right) => left.title.localeCompare(right.title));

const types = [...new Set(entries.map((entry) => entry.type))].sort();
const categories = [
  ...new Set(
    entries.flatMap((entry) =>
      entry.type === 'container' ? [entry.container.category] : [],
    ),
  ),
].sort();
const lifecycles = [...new Set(entries.map((entry) => entry.lifecycle))].sort();
---

<section class="catalog" data-service-catalog>
  <form class="catalog-controls" aria-label="Filter the CaaS catalog">
    <label class="search-field">
      <span>Find a CaaS entry</span>
      <input
        type="search"
        name="q"
        placeholder="Try “cache”, “python”, or “minimal image”"
        autocomplete="off"
        data-search
      />
    </label>

    <label>
      <span>Type</span>
      <select name="type" data-type>
        <option value="">All types</option>
        {types.map((type) => <option value={type}>{type}</option>)}
      </select>
    </label>

    <label>
      <span>Container category</span>
      <select name="category" data-category>
        <option value="">All categories</option>
        {
          categories.map((category) => (
            <option value={category}>{category}</option>
          ))
        }
      </select>
    </label>

    <label>
      <span>Lifecycle</span>
      <select name="lifecycle" data-lifecycle>
        <option value="">All lifecycles</option>
        {
          lifecycles.map((lifecycle) => (
            <option value={lifecycle}>{lifecycle}</option>
          ))
        }
      </select>
    </label>

    <label>
      <span>Storage</span>
      <select name="stateful" data-stateful>
        <option value="">Any storage model</option>
        <option value="false">Stateless</option>
        <option value="true">Stateful</option>
      </select>
    </label>
  </form>

  <div class="catalog-summary" aria-live="polite">
    <span data-result-count>{entries.length} entries</span>
    <button type="button" class="reset-button" data-reset>Reset filters</button>
  </div>

  <div class="service-grid" data-service-grid>
    {
      entries.map((entry) => (
        <article
          class="service-card"
          data-service-card
          data-type={entry.type}
          data-category={
            entry.type === 'container' ? entry.container.category : undefined
          }
          data-lifecycle={entry.lifecycle}
          data-stateful={
            entry.type === 'container'
              ? String(entry.container.stateful)
              : undefined
          }
          data-search-text={[
            entry.title,
            entry.description,
            entry.type,
            ...entry.aliases,
            ...entry.capabilities,
            entry.upstream.name,
            entry.upstream.description,
            ...(entry.type === 'container'
              ? [
                  entry.container.category,
                  entry.container.image,
                  ...entry.container.protocols,
                  ...entry.container.versions,
                ]
              : [
                  entry.chart.name,
                  entry.chart.repository,
                  ...entry.chart.versions,
                  ...entry.chart.containers,
                ]),
          ]
            .join(' ')
            .toLocaleLowerCase()}
        >
          <div class="service-card__header">
            <span class="service-kind">
              {entry.type}
              {entry.type === 'container' && ` · ${entry.container.category}`}
            </span>
            <span class={`lifecycle lifecycle--${entry.lifecycle}`}>
              {entry.lifecycle}
            </span>
          </div>
          <h2>
            <a href={entry.href}>{entry.title}</a>
          </h2>
          <p>{entry.description}</p>
          <ul class="service-capabilities" aria-label="Capabilities">
            {entry.capabilities.slice(0, 3).map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          <div class="service-card__footer">
            {entry.type === 'container' ? (
              <>
                <span>
                  {entry.container.stateful ? 'Stateful' : 'Stateless'}
                </span>
                <span>{entry.container.architectures.join(' · ')}</span>
              </>
            ) : (
              <>
                <span>
                  {entry.chart.containers.length}{' '}
                  {entry.chart.containers.length === 1
                    ? 'container'
                    : 'containers'}
                </span>
                <span>{entry.chart.versions.join(' · ')}</span>
              </>
            )}
          </div>
        </article>
      ))
    }
  </div>

  <div class="empty-state" data-empty-state hidden>
    <h2>No CaaS entry matched</h2>
    <p>Try a broader term or reset one of the filters.</p>
  </div>
</section>

<script>
  const catalog = document.querySelector<HTMLElement>('[data-service-catalog]');

  if (catalog) {
    const search = catalog.querySelector<HTMLInputElement>('[data-search]')!;
    const type = catalog.querySelector<HTMLSelectElement>('[data-type]')!;
    const category =
      catalog.querySelector<HTMLSelectElement>('[data-category]')!;
    const lifecycle =
      catalog.querySelector<HTMLSelectElement>('[data-lifecycle]')!;
    const stateful =
      catalog.querySelector<HTMLSelectElement>('[data-stateful]')!;
    const cards = [
      ...catalog.querySelectorAll<HTMLElement>('[data-service-card]'),
    ];
    const count = catalog.querySelector<HTMLElement>('[data-result-count]')!;
    const empty = catalog.querySelector<HTMLElement>('[data-empty-state]')!;
    const reset = catalog.querySelector<HTMLButtonElement>('[data-reset]')!;

    const params = new URLSearchParams(window.location.search);
    search.value = params.get('q') ?? '';
    type.value = params.get('type') ?? '';
    category.value = params.get('category') ?? '';
    lifecycle.value = params.get('lifecycle') ?? '';
    stateful.value = params.get('stateful') ?? '';

    const update = () => {
      const terms = search.value
        .trim()
        .toLocaleLowerCase()
        .split(/\s+/)
        .filter(Boolean);
      let visible = 0;

      for (const card of cards) {
        const matchesText = terms.every((term) =>
          card.dataset.searchText?.includes(term),
        );
        const matchesType = !type.value || card.dataset.type === type.value;
        const matchesCategory =
          !category.value || card.dataset.category === category.value;
        const matchesLifecycle =
          !lifecycle.value || card.dataset.lifecycle === lifecycle.value;
        const matchesState =
          !stateful.value || card.dataset.stateful === stateful.value;
        const matches =
          matchesText &&
          matchesType &&
          matchesCategory &&
          matchesLifecycle &&
          matchesState;

        card.hidden = !matches;
        if (matches) visible += 1;
      }

      count.textContent = `${visible} ${visible === 1 ? 'entry' : 'entries'}`;
      empty.hidden = visible !== 0;

      const nextParams = new URLSearchParams();
      if (search.value.trim()) nextParams.set('q', search.value.trim());
      if (type.value) nextParams.set('type', type.value);
      if (category.value) nextParams.set('category', category.value);
      if (lifecycle.value) nextParams.set('lifecycle', lifecycle.value);
      if (stateful.value) nextParams.set('stateful', stateful.value);
      const query = nextParams.toString();
      history.replaceState(null, '', query ? `?${query}` : location.pathname);
    };

    catalog.addEventListener('input', update);
    catalog.addEventListener('change', update);
    reset.addEventListener('click', () => {
      search.value = '';
      type.value = '';
      category.value = '';
      lifecycle.value = '';
      stateful.value = '';
      update();
      search.focus();
    });

    update();
  }
</script>
